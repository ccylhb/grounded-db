---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import weapons from "../../data/weapons.json";
import { cl, desc, stats, best } from "../../lib/seo";

export async function getStaticPaths() {
  const weapons = (await import("../../data/weapons.json")).default;
  return weapons.filter((w) => !/\(Grounded\)$/.test(String(w.title))).map((w) => ({ params: { slug: w.slug }, props: { w } }));
}
const { w } = Astro.props;
const dmgParts = String(w.damage || "").split("/").filter(Boolean);
const sameType = w.type
  ? weapons.filter((x) => x.type === w.type && x.slug !== w.slug).slice(0, 3)
  : [];

// SEO: damage / stun numbers first, then the scraped summary sentence.
const description = desc(
  `${w.title} —`,
  stats(
    cl(w.tier) && `Tier ${cl(w.tier)}`,
    cl(w.type || w.subcat) && cl(w.type || w.subcat),
    cl(w.damage) && `damage ${cl(w.damage)}`,
    cl(w.damagecharge) && `charged attack ${cl(w.damagecharge)}`,
    cl(w.stun) && `stun ${cl(w.stun)}`,
    cl(w.durability) && `durability ${cl(w.durability)}`
  ),
  best(w.summary, `Grounded weapon: damage, stun, speed and durability.`)
);
---

<Base
  title={`${w.title} — Grounded Weapon Stats`}
  description={description}
>
  <p style="margin:0"><a href="/weapons/">← All weapons</a></p>
  <h1 class="icon-h1">
    {w.icon && <img src={w.icon} alt="" width="52" height="52" loading="eager" />}
    {w.title}
  </h1>
  <p>
    {w.tier && <span class="tag">Tier {w.tier}</span>}
    {w.type && <span class="tag">{w.type}</span>}
    {w.subcat && <span class="tag">{w.subcat}</span>}
    {w.augmenttype && <span class="tag hot">{w.augmenttype} damage</span>}
  </p>

  {w.summary && <p class="muted">{w.summary}</p>}

  {(dmgParts.length > 0 || w.damagecharge) && (
    <div class="card answer-card">
      <div class="stat-row">
        <div>
          <div class="stat-num">{w.damage || "—"}</div>
          <div class="stat-label">Damage</div>
        </div>
        <div>
          <div class="stat-num">{w.damagecharge || "—"}</div>
          <div class="stat-label">Charged attack</div>
        </div>
        <div>
          <div class="stat-num">{w.stun || "—"}</div>
          <div class="stat-label">Stun</div>
        </div>
        <div>
          <div class="stat-num">{w.stuncharge || "—"}</div>
          <div class="stat-label">Charged stun</div>
        </div>
      </div>
    </div>
  )}

  <h2>Full stats</h2>
  <table>
    <tbody>
      {[
        ["Speed", w.speed],
        ["Charged speed", w.speedcharge],
        ["Throw damage", w.damagethrow],
        ["Throw stun", w.stunthrow],
        ["Stamina cost", w.stam],
        ["Durability", w.durability],
        ["Damage type", w.tooltype || w.augmenttype],
        ["Level 6 perk", w.perklvl],
        ["Repair cost", w.repair],
        ["How to get", w.urecipe],
      ].filter(([, v]) => v).map(([k, v]) => (
        <tr><th style="width:40%">{k}</th><td>{v}</td></tr>
      ))}
    </tbody>
  </table>

  {w.description && <p class="muted">{w.description}</p>}

  <Related
    heading="Next steps"
    links={[
      { href: "/rankings/", title: "Weapon damage rankings", sub: "Where this weapon lands", tool: true },
      { href: "/loot/", title: "Loot table", sub: "Where the crafting materials drop", tool: true },
      ...(w.tooltype ? [{ href: "/rankings/", title: "Creature weakness cheat sheet", sub: `Find bugs weak to ${w.tooltype}`, tool: true }] : []),
      ...sameType.map((x) => ({ href: `/weapons/${x.slug}/`, title: x.title, sub: `${x.type} · ${x.damage || "?"} dmg`, icon: x.icon })),
    ]}
  />
</Base>

---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import consumables from "../../data/consumables.json";
import { cl, desc, stats, best } from "../../lib/seo";

export async function getStaticPaths() {
  const consumables = (await import("../../data/consumables.json")).default;
  return consumables.filter((c) => !/\(Grounded\)$/.test(String(c.title))).map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const kind = (c._ib || "").replace("Infobox/", "").split("/").join("-");
const ingredients = [c.ingredient1, c.ingredient2, c.ingredient3, c.ingredient4].filter(Boolean);
const effects = [c.effect1, c.effect2, c.effect3].filter(Boolean);
const sameKind = c._ib
  ? consumables.filter((x) => x._ib === c._ib && x.slug !== c.slug).slice(0, 3)
  : [];

// SEO: lead with the numbers, then the scraped summary sentence.
const allEffects = [c.effect1, c.effect2, c.effect3, c.effect4].map((e) => cl(e)).filter(Boolean);
const allIng = [c.ingredient1, c.ingredient2, c.ingredient3, c.ingredient4].map((i) => cl(i)).filter(Boolean);
const description = desc(
  `${c.title} —`,
  stats(
    cl(c.food) && `restores ${cl(c.food)} hunger`,
    cl(c.tier) && `Tier ${cl(c.tier)} ${cl(c.subcat) || "item"}`,
    allEffects.length > 0 && `effect: ${allEffects.join(", ")}`,
    allIng.length > 0 && `recipe: ${allIng.join(" + ")}`,
    allIng.length === 0 && cl(c.urecipe) && `unlocked by ${cl(c.urecipe)}`
  ),
  best(c.summary, `Grounded ${kind || "consumable"}: effect, recipe and how to unlock it.`)
);
---

<Base
  title={`${c.title} — Grounded ${kind || "Consumable"} Recipe & Effect`}
  description={description}
>
  <p style="margin:0"><a href="/consumables/">← All consumables</a></p>
  <h1 class="icon-h1">
    {c.icon && <img src={c.icon} alt="" width="52" height="52" loading="eager" />}
    {c.title}
  </h1>
  <p>
    {kind && <span class="tag">{kind}</span>}
    {effects.map((e) => <span class="tag hot">{e}</span>)}
  </p>

  {c.summary && <p class="muted">{c.summary}</p>}

  {(ingredients.length > 0 || c.urecipe) && (
    <div class="card answer-card">
      <div class="stat-row">
        <div style="grid-column:span 2">
          <div class="stat-num" style="font-size:1.4rem">
            {ingredients.length > 0 ? ingredients.join(" + ") : c.urecipe || "—"}
          </div>
          <div class="stat-label">{ingredients.length > 0 ? "Recipe" : "How to get"}</div>
        </div>
      </div>
    </div>
  )}

  {c.description && <p class="muted">{c.description}</p>}

  <Related
    heading="Next steps"
    links={[
      { href: "/calculator/", title: "Smoothie planner", sub: "Batch your ingredients & buffs", tool: true },
      { href: "/loot/", title: "Loot table", sub: "Where to farm these ingredients", tool: true },
      ...sameKind.map((x) => ({ href: `/consumables/${x.slug}/`, title: x.title, sub: x.effect1 || "Consumable", icon: x.icon })),
    ]}
  />
</Base>

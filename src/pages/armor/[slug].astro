---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import armor from "../../data/armor.json";
import { cl, desc, stats, best } from "../../lib/seo";

export async function getStaticPaths() {
  const armor = (await import("../../data/armor.json")).default;
  return armor.filter((a) => !/\(Grounded\)$/.test(String(a.title))).map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const totalDef = a.pieces.reduce((s, p) => s + p.defense, 0);
const totalRes = a.pieces.reduce((s, p) => s + p.resist, 0);
const sameTier = a.tier
  ? armor.filter((x) => x.tier === a.tier && x.slug !== a.slug).slice(0, 3)
  : [];

// SEO: de-duplicated set totals first, then the scraped summary sentence.
const uniqPieces = a.pieces.filter((p, i, arr) => arr.findIndex((q) => q.name === p.name) === i);
const setDef = uniqPieces.reduce((s, p) => s + (Number(p.defense) || 0), 0);
const setRes = uniqPieces.reduce((s, p) => s + (Number(p.resist) || 0), 0);
const description = desc(
  `${a.title.replace(/ Armor$/, "")} set —`,
  stats(
    cl(a.tier) && `Tier ${cl(a.tier)}`,
    uniqPieces.length > 0 && `${uniqPieces.length} pieces, ${setDef} total defense, ${setRes}% resistance`,
    cl(a.setBonus) && `set bonus: ${cl(a.setBonus)}`
  ),
  best(a.summary, `Grounded armor set: per-piece defense, resistance and set bonus.`)
);
---

<Base
  title={`${a.title} — Grounded Armor Set Stats & Set Bonus`}
  description={description}
>
  <p style="margin:0"><a href="/armor/">← All armor sets</a></p>
  <h1 class="icon-h1">
    {a.icon && <img src={a.icon} alt="" width="52" height="52" loading="eager" />}
    {a.title.replace(/ Armor$/, "")} Set
  </h1>
  <p>
    {a.tier && <span class="tag">Tier {a.tier}</span>}
    {a.setBonus && <span class="tag hot">Set bonus: {a.setBonus}</span>}
    {a.pieceEffect && <span class="tag">Piece effect: {a.pieceEffect}</span>}
  </p>

  {a.summary && <p class="muted">{a.summary}</p>}

  {a.pieces.length > 0 && (
    <div class="card answer-card">
      <div class="stat-row">
        {a.pieces.map((p) => (
          <div>
            <div class="stat-num">{p.defense}</div>
            <div class="stat-label">{p.name} — {p.resist}% resist</div>
          </div>
        ))}
        <div>
          <div class="stat-num">{totalDef}</div>
          <div class="stat-label">Total defense</div>
        </div>
      </div>
    </div>
  )}

  {a.pieces.length === 0 && <p class="muted">Per-piece numbers for this set were not published on the wiki in a parseable table. Check back after the next data refresh.</p>}

  {a.description && <p class="muted">{a.description}</p>}

  <Related
    heading="Next steps"
    links={[
      { href: "/rankings/", title: "Armor sets ranked", sub: "All sets by defense & resistance", tool: true },
      { href: "/calculator/", title: "Smoothie planner", sub: "Total your buffs before a big fight", tool: true },
      { href: "/loot/", title: "Loot table", sub: "Where the crafting materials drop", tool: true },
      ...sameTier.map((x) => ({ href: `/armor/${x.slug}/`, title: x.title, sub: x.tier ? `Tier ${x.tier} set` : "Armor set", icon: x.icon })),
    ]}
  />
</Base>

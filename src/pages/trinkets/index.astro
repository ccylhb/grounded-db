---
import Base from "../../layouts/Base.astro";
import DataTable from "../../components/DataTable.astro";
import trinkets from "../../data/trinkets.json";

const num = (v: unknown): number => {
  const n = parseFloat(String(v ?? ""));
  return Number.isFinite(n) ? n : 0;
};
// Mirrors the [slug].astro filter. Without it the table linked
// /trinkets/Trinkets_(Grounded)/, a list page that is never generated.
const all = trinkets.filter((t) => !/\(Grounded\)$/.test(String(t.title)));
const byTier = [...all].sort((a, b) => num(b.tier) - num(a.tier));
---

<Base
  title="Grounded Trinkets — Every Trinket Effect & Location"
  description="All Grounded trinkets with their effect, tier and where to find them. Complete sortable list."
>
  <h1>Trinkets</h1>
  <p class="muted">{trinkets.length} trinkets, sorted by tier.</p>

  <DataTable
    head={["Trinket", "Tier", "Effect", "Location"]}
    rows={byTier.map((t) => [
      `<a href="/trinkets/${t.slug}/">${t.title}</a>`,
      t.tier || "—",
      t.effect || "—",
      t.location || "—",
    ])}
    searchPlaceholder="Search trinkets..."
  />
</Base>
